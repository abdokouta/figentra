{
  "name": "@stackra/settings",
  "version": "1.0.2",
  "description": "Unified settings framework for the Stackra platform — registry-based with @Setting()/@Field()/@Group()/@Section() decorators, multi-driver persistence over @stackra/storage + @stackra/http, sync-cache + async-hydrate + debounced persist, real-time broadcast via @stackra/realtime, and HeroUI-driven admin UI.",
  "license": "MIT",
  "author": {
    "name": "Figentra L.L.C",
    "email": "dev@figentra.com",
    "url": "https://figentra.com"
  },
  "keywords": [
    "stackra",
    "settings",
    "configuration",
    "registry",
    "dto",
    "decorators",
    "react",
    "cross-platform"
  ],
  "homepage": "https://gitlab.com/stackra/frontend/platform/-/tree/main/src/settings#readme",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/stackra/frontend/platform.git",
    "directory": "src/settings"
  },
  "bugs": {
    "url": "https://gitlab.com/stackra/frontend/platform/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
