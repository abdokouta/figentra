{
  "name": "@figentra/application-registry",
  "version": "0.0.1",
  "description": "Figentra Application Registry \u2014 application metadata, versions, and environments (Cloudflare Worker + Hono + D1).",
  "author": "Figentra L.L.C <dev@figentra.com>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint src __tests__",
    "lint:fix": "oxlint --fix src __tests__",
    "format": "prettier --write .",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "check-types": "pnpm run typecheck",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm run typecheck && pnpm test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:watch": "vitest",
    "deploy:development": "wrangler deploy --env development --minify",
    "deploy:staging": "wrangler deploy --env staging --minify",
    "deploy:production": "wrangler deploy --env production --minify"
  },
  "dependencies": {
    "hono": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:",
    "@figentra/observability": "workspace:*",
    "pino": "catalog:",
    "hono-pino": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@stackra/oxlint-config": "workspace:*",
    "@stackra/prettier-config": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
