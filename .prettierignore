# Prettier does NOT read .gitignore — heavy / generated / vendored trees are
# listed here explicitly so `pnpm format` (prettier --write .) stays fast and
# never rewrites machine-owned or reference material.

# Dependencies + package store
node_modules
.pnpm-store

# Build + tool outputs
dist
build
out
.next
coverage
.turbo
.vercel

# Cloudflare Wrangler
.wrangler
.dev.vars
.dev.vars.*

# Terraform (state + provider mirror)
.terraform
*.tfstate
*.tfstate.*

# Machine-owned infrastructure output (catalog, docker-compose, tf plans).
# Every file inside is regenerated on demand; never reformat.
infrastructure/.generated/

# Lockfiles (owned by the package manager, not the formatter)
pnpm-lock.yaml

# Reference material — inherited architecture snapshot, never reformatted
.ref

# Project templates — carry {{PLACEHOLDER}} tokens that Prettier can't parse.
# The bootstrap scripts replace tokens at copy time; Prettier runs AFTER copy.
.templates
