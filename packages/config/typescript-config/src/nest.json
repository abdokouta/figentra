{
  // @stackra/typescript-config — NestJS service.
  //
  // Server-side runtime profile for NestJS apps (Express/Fastify adapter,
  // decorators + DI, reflect-metadata). The base already enables
  // experimentalDecorators + emitDecoratorMetadata + full strictness, so this
  // profile only re-targets the runtime:
  //   - drops the DOM libs (server has no window),
  //   - adds Node ambient types (base pins `types: []`),
  //   - flips noEmit off (base assumes a bundler emits; a service compiles to
  //     dist via `nest build`).
  // module/moduleResolution stay ESNext/bundler (inherited) so extensionless
  // TS imports type-check cleanly; the swc/nest build owns the real emit.
  //
  // Usage — services/<name>/tsconfig.json:
  //   { "extends": "@stackra/typescript-config/nest" }
  "display": "@stackra/typescript-config — NestJS service",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "test", "**/*.spec.ts"]
}
