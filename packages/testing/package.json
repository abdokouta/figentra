{
  "name": "@stackra/testing",
  "version": "1.0.2",
  "description": "Shared Vitest preset, setup lifecycle, and assertable primitives for the Stackra monorepo \u2014 SWC-based transform with full decorator metadata support.",
  "license": "MIT",
  "author": {
    "name": "Figentra L.L.C",
    "email": "dev@figentra.com",
    "url": "https://figentra.com"
  },
  "keywords": [
    "stackra",
    "vitest",
    "vitest-preset",
    "testing",
    "swc",
    "decorators",
    "assertable"
  ],
  "homepage": "https://gitlab.com/stackra/frontend/framework/-/tree/main/src/testing#readme",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/stackra/frontend/framework.git",
    "directory": "src/testing"
  },
  "bugs": {
    "url": "https://gitlab.com/stackra/frontend/framework/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "./src/preset/setup.ts",
    "./src/native/setup.ts",
    "./dist/setup.js",
    "./dist/setup.mjs",
    "./dist/native-setup.js",
    "./dist/native-setup.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.mjs",
      "require": "./dist/matchers.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.mjs",
      "require": "./dist/preset.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.mjs",
      "require": "./dist/setup.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs",
      "require": "./dist/native.js"
    },
    "./native/setup": {
      "types": "./dist/native-setup.d.ts",
      "import": "./dist/native-setup.mjs",
      "require": "./dist/native-setup.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@swc/core": "catalog:",
    "unplugin-swc": "catalog:"
  },
  "peerDependencies": {
    "@react-native/jest-preset": "catalog:",
    "@testing-library/react-native": "catalog:",
    "jest": "catalog:",
    "react-native": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@react-native/jest-preset": {
      "optional": true
    },
    "@testing-library/react-native": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "vitest": {
      "optional": false
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "catalog:",
    "@stackra/tsup-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "react-native": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
