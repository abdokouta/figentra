{
  "extends": "@stackra/typescript-config/base",
  "compilerOptions": {
    "types": ["node", "jest"],
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"],
  "compileOnSave": false
}
