{
  "name": "@vivel/metadata",
  "version": "1.0.0",
  "description": "A lightweight utility library for enhanced metadata operations in TypeScript with improved reflect-metadata extensions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"**/*.ts\"",
    "format": "prettier --write \"**/*.ts\"",
    "docs": "typedoc --out docs src",
    "prepare-husky": "husky",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A",
    "postversion": "git push && git push --tags",
    "changeset": "changeset",
    "version-packages": "changeset version && git add . && git commit -m \"Version Packages\"",
    "release": "npm run build && changeset publish",
    "commit": "git-cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akouta/vivel.git",
    "directory": "packages/metadata"
  },
  "keywords": [
    "typescript",
    "metadata",
    "reflect-metadata",
    "decorators",
    "reflection",
    "utilities"
  ],
  "author": "Akouta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akouta/vivel/issues"
  },
  "homepage": "https://github.com/akouta/vivel/tree/main/packages/metadata#readme",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.3"
}
