{
  "name": "@stackra/contracts",
  "version": "1.7.0",
  "description": "Shared interfaces, types, enums, and DI tokens for the Stackra ecosystem. Zero runtime implementation.",
  "license": "MIT",
  "author": {
    "name": "Figentra L.L.C",
    "email": "dev@figentra.com",
    "url": "https://figentra.com"
  },
  "keywords": [
    "stackra",
    "contracts",
    "interfaces",
    "tokens",
    "dependency-injection"
  ],
  "homepage": "https://gitlab.com/stackra/frontend/framework/-/tree/main/src/contracts#readme",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/stackra/frontend/framework.git",
    "directory": "src/contracts"
  },
  "bugs": {
    "url": "https://gitlab.com/stackra/frontend/framework/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsup-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
