{
  "name": "@figentra/observability",
  "version": "0.2.0",
  "private": true,
  "description": "Figentra cross-runtime observability, telemetry, logging contracts, Nest Observe integration, Worker logging integration, and testing primitives.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "dependencies": {
    "@nestjs/devtools-integration": "catalog:",
    "@nestjs/observe": "catalog:",
    "@hono/structured-logger": "catalog:",
    "pino": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "hono": "catalog:",
    "rxjs": "catalog:"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint src __tests__",
    "lint:fix": "oxlint --fix src __tests__",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@stackra/oxlint-config": "workspace:*",
    "@stackra/prettier-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/tsup-config": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
