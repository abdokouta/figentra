{
  "name": "@stackra/network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral network and service-to-service HTTP transport primitives.",
  "license": "UNLICENSED",
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint src __tests__",
    "lint:fix": "oxlint --fix src __tests__",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check-types": "pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@stackra/oxlint-config": "workspace:*",
    "@stackra/prettier-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/tsup-config": "workspace:*",
    "@stackra/testing": "workspace:*",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
