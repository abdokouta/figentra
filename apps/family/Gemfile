# frozen_string_literal: true

# Ruby dependencies for the iOS build side of Expo's `run:ios`.
#
# `cocoapods` MUST be pinned to `1.16.2` in every pnpm-workspace mobile
# app. `1.17.0` reintroduces a `Pathname#realdirpath` regression
# (CocoaPods issue #12866) that trips on pnpm's `.pnpm/<pkg>_HASH/`
# symlink layout during `add_source_files_references`, aborting with
# `ArgumentError - pathname contains null byte`. The system-wide
# `/opt/homebrew/bin/pod` is already 1.16.2 today, but this Gemfile
# stops Expo from silently pulling 1.17.0 into
# `apps/academorix-family/vendor/bundle/` on a subsequent
# `expo run:ios` invocation.
#
# Bump only after CocoaPods lands a 1.17.x that fixes issue #12866
# AND we've verified `pod install --repo-update` from the app's `ios/`
# folder completes without the null-byte trace.

source "https://rubygems.org"

# Match the version pinned in `.ruby-version` at the app root.
ruby "3.3.12"

# Pin CocoaPods to the last version compatible with pnpm's symlinked
# node_modules layout on macOS.
gem "cocoapods", "= 1.16.2"

# `activesupport` is a transitive of `cocoapods`. `~> 7.0.8` is the
# highest Ruby-3.3-compatible line the CocoaPods 1.16.2 lockfile
# resolves without back-tracking.
gem "activesupport", ">= 6.1.7.5", "< 7.1.0"
