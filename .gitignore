# Terraform (spec 15 §6 — state is never committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
.terraform.tfstate.lock.info
# NOTE: .terraform.lock.hcl IS committed (provider version lock).

# Machine-owned generated infrastructure artefacts — regenerated on demand by
# `pnpm run catalog` + the Compose / Terraform generator scripts. Never
# hand-edit; never commit. The README inside is the ONE tracked file — it
# documents what lives in the folder + how to regenerate everything else.
infrastructure/.generated/
!infrastructure/.generated/README.md

# Cloudflare Wrangler
.wrangler/

# Scratch & Temporary storage
.tmp/
tmp/