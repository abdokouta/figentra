# FigenTra registry/auth policy. Non-registry pnpm settings live in pnpm-workspace.yaml.
registry=https://registry.npmjs.org/

# Enterprise supply-chain hygiene.
# `fund=false`         — silence funding banners in CI + local installs.
# `auto-install-peers` — install peer deps automatically; the workspace's
#   packages declare optional peers per `.kiro/steering/subpath-layering.md`
#   §"Peer-dep classification" and consumers should get them by default.
fund=false
auto-install-peers=true
