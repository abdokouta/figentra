{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_GATEWAY_URL": "http://localhost:8001",
        "EXPO_PUBLIC_AUTH_URL": "http://localhost:8001/identity/api/v1/auth"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://api.dev.academorix.com",
        "EXPO_PUBLIC_GATEWAY_URL": "https://api.dev.figentra.com",
        "EXPO_PUBLIC_AUTH_URL": "https://api.dev.figentra.com/identity/api/v1/auth"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.academorix.com",
        "EXPO_PUBLIC_GATEWAY_URL": "https://api.figentra.com",
        "EXPO_PUBLIC_AUTH_URL": "https://api.figentra.com/identity/api/v1/auth"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$APP_STORE_CONNECT_APPLE_ID",
        "ascAppId": "$APP_STORE_CONNECT_ASC_APP_ID",
        "appleTeamId": "$APP_STORE_CONNECT_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
        "track": "internal"
      }
    }
  }
}
