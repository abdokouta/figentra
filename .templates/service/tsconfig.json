{
  "extends": "@stackra/typescript-config/base",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
